# Copy this file to .env and fill in real values. NEVER commit .env
NODE_ENV=development
PORT=4000

# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio_cms?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio_cms?retryWrites=true&w=majority

# Comma-separated list of origins allowed to call the API (portfolio frontend + admin panel)
CLIENT_URLS=http://localhost:3000,http://localhost:5173

# JWT secrets: two DIFFERENT long random strings. Generate each one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Only needed once, for: npm run create-admin  (delete ADMIN_PASSWORD afterwards)
ADMIN_NAME=Your Name
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=ChangeMe123
