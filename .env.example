NODE_ENV=development
PORT=4000
# From Atlas: Connect > Drivers. Replace <db_password> and drop the angle brackets.
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/portfolio_cms?appName=Cluster0
# Comma-separated list of frontend origins allowed by CORS
CLIENT_URLS=http://localhost:3000,http://localhost:5173
